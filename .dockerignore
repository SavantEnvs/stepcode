# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts and editor/OS cruft. Dev image, not minimal.

# ── Build outputs / local cruft ──────────────────────────────────────────────
# mayhem/build.sh builds into build/, build-tests/ and mayhem/.manuallink/ at image-build time —
# keep any locally-left-over copies of those out of the build CONTEXT (they are regenerated inside
# the image regardless).
build/
build-*/
mayhem/.manuallink/
*.o
*.a
*.so
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
